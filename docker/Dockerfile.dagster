FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /opt/dagster/app

COPY pyproject.toml /opt/dagster/app/pyproject.toml
COPY uv.lock /opt/dagster/app/uv.lock
COPY README.md /opt/dagster/app/README.md

COPY imgw /opt/dagster/app/imgw
COPY dags /opt/dagster/app/dags
COPY pipeline.py /opt/dagster/app/pipeline.py

RUN uv sync --frozen --all-extras

ENV VIRTUAL_ENV=/opt/dagster/app/.venv \
  PATH="/opt/dagster/app/.venv/bin:$PATH" \
  PYTHONPATH=/opt/dagster/app \
  DAGSTER_CURRENT_IMAGE='imgw:0.0.1-dagster'

EXPOSE 4000

ENTRYPOINT ["uv", "run", "dagster", "code-server", "start", "-h", "0.0.0.0", "-p", "4000", "-m", "dags.dagster.definitions"]

CMD []
